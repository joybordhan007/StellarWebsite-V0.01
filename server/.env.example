# Copy to .env and fill in. On cPanel you can set these in "Setup Node.js App" instead.

NODE_ENV=production
PORT=3001

# Database. "sqlite" (default) keeps everything in one file under server/data —
# nothing to set up on the hosting, needs Node.js 22.13+.
# Use "mysql" only if you prefer a MySQL database (then fill in DB_HOST ... DB_NAME).
DB_CLIENT=sqlite
SQLITE_FILE=./data/stellar.sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=stellar_user
# DB_PASSWORD=change-me
# DB_NAME=stellar_db

# Optional. Signs admin login sessions; if left out, a random one is created in data/jwt-secret.
# JWT_SECRET=a-long-random-string-of-32-or-more-characters

# First admin account, created on first start when no admin exists yet.
# Change the password from the dashboard after the first login.
ADMIN_EMAIL=admin@stellar-mfg.com
ADMIN_PASSWORD=change-me-now

# Where uploaded images are stored, and where the built website (pnpm build) lives.
UPLOAD_DIR=./uploads
CLIENT_DIST=../dist
