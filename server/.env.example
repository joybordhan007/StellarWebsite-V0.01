# Copy to .env and fill in. On cPanel you can set these in "Setup Node.js App" instead.

NODE_ENV=production
PORT=3001

# Database: "mysql" for hosting, "sqlite" for local development (Node 22.13+ built-in, no install).
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=stellar_user
DB_PASSWORD=change-me
DB_NAME=stellar_db
# Used only when DB_CLIENT=sqlite
SQLITE_FILE=./data/dev.sqlite

# Long random string (at least 32 characters). Signs admin login sessions.
JWT_SECRET=replace-with-a-long-random-string

# First admin account, created on first start when no admin exists yet.
# Change the password from the dashboard after the first login.
ADMIN_EMAIL=admin@stellar-mfg.com
ADMIN_PASSWORD=change-me-now

# Where uploaded images are stored, and where the built website (pnpm build) lives.
UPLOAD_DIR=./uploads
CLIENT_DIST=../dist
